@PACKAGE_INIT@

# fynepdf-grayscale, a static library: its dependencies come with it.
include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(qpdf CONFIG)
find_dependency(JPEG)
if(@FYNEPDF_GRAYSCALE_FOUND_OPENJPEG@)
    find_dependency(OpenJPEG CONFIG)
endif()
if(@FYNEPDF_GRAYSCALE_FOUND_LCMS@)
    find_dependency(LCMS2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/fynepdf_grayscaleTargets.cmake")

# A static qpdf names zlib and libjpeg bare (-lz -ljpeg): they are found in its own folder.
get_target_property(_fynepdf_grayscale_qpdf_type qpdf::libqpdf TYPE)
if(_fynepdf_grayscale_qpdf_type STREQUAL "STATIC_LIBRARY")
    set_property(TARGET fynepdf::grayscale APPEND PROPERTY INTERFACE_LINK_DIRECTORIES "$<TARGET_LINKER_FILE_DIR:qpdf::libqpdf>")
endif()

check_required_components(fynepdf_grayscale)
